{
  "name": "mirath-guide",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve mirath-guide",
    "build": "node scripts/generate-sitemap.mjs && ng build mirath-guide && node scripts/postprocess-prerender.mjs",
    "watch": "node scripts/generate-sitemap.mjs && ng build mirath-guide --watch --configuration development",
    "test": "ng test mirath-guide",
    "lint": "ng lint mirath-guide",
    "serve:ssr:mirath-guide": "NG_ALLOWED_HOSTS=localhost node dist/mirath-guide/server/server.mjs",
    "build:app": "ng build mirath-guide-app",
    "start:app": "ng serve mirath-guide-app",
    "sync:app": "npm run build:app && cap sync",
    "android": "npm run sync:app && cap open android",
    "ios": "npm run sync:app && cap open ios",
    "run:android": "npm run sync:app && cap run android",
    "run:ios": "npm run sync:app && cap run ios",
    "gen:assets": "node scripts/generate-app-assets.mjs",
    "apk": "bash scripts/build-apk.sh"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/platform-server": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/ssr": "^19.2.27",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.2.11",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.2.10",
    "@lucide/angular": "^1.23.0",
    "express": "^4.18.2",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "angular-eslint": "21.0.1",
    "eslint": "^9.39.1",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sharp": "^0.34.5",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.46.4"
  }
}
